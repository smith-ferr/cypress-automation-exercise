{
  "name": "cypress-automation-exercise",
  "version": "1.0.0",
  "description": "Testes E2E e de API com Cypress no site de prática Automation Exercise",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:interface": "cypress run --spec \"cypress/e2e/interface/**/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\""
  },
  "author": "Ézio Ferreira",
  "license": "MIT",
  "devDependencies": {
    "cypress": "16.2.0",
    "cypress-mochawesome-reporter": "^3.8.2"
  },
  "allowScripts": {
    "cypress@16.2.0": true
  }
}
